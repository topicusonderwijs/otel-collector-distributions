{
  extends: [
   'local>topicusonderwijs/renovate-config:default.json5',
  ],
  semanticCommits: "enabled",
  ocb: {
    managerFilePatterns: ["distributions/**/manifest.yaml"]
  },
  enabledManagers: ["github-actions", "dockerfile", "gomod", "ocb"],
  packageRules: [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      matchManagers: ["dockerfile"],
      matchDepTypes: ["stage"],
      matchDepNames: ["ocb"],
      enabled: false
    },
    {
      // OTel components must be on the same release to compile, so bump them together,
      // with one PR per distribution (branch name gets the distribution directory)
      matchManagers: ["ocb"],
      matchPackageNames: [
        "go.opentelemetry.io/collector/**",
        "github.com/open-telemetry/opentelemetry-collector-contrib/**"
      ],
      groupName: "opentelemetry-collector",
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageSuffix: "({{parentDir}})"
    },
    {
      matchManagers: ["dockerfile", "gomod", "ocb"],
      matchUpdateTypes: ["minor"],
      automerge: true,
      extends: ["schedule:automergeWeekly"]
    },
    {
      matchManagers: ["dockerfile", "gomod", "ocb"],
      matchUpdateTypes: ["patch"],
      automerge: true,
      extends: ["schedule:automergeDaily"]
    }
  ]
}
